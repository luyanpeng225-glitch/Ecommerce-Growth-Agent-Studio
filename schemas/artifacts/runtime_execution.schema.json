{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/artifacts/runtime_execution.schema.json",
  "title": "Real Runtime Execution Log",
  "description": "Schema for an instrumented Real Runtime execution log. It validates structure and anti-fabrication boundaries; real values must still be captured only by the Runtime Runner during execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "run_type",
    "execution_context",
    "scenario_name",
    "run_status",
    "started_at",
    "ended_at",
    "duration_ms",
    "timing_status",
    "nodes",
    "parallel_groups",
    "runtime_summary",
    "human_approval",
    "release_gates",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "description": "Real Runtime run_id. It must be generated only by the Runtime Runner during a real execution, not by schema examples or historical reconstruction.",
      "type": "string",
      "minLength": 1
    },
    "run_type": {
      "const": "real_runtime"
    },
    "execution_context": {
      "enum": [
        "instrumented_local_run",
        "local_historical_playback",
        "deterministic_test"
      ]
    },
    "scenario_name": {
      "type": "string",
      "minLength": 1
    },
    "run_status": {
      "$ref": "#/$defs/runStatus"
    },
    "started_at": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "ended_at": {
      "$ref": "#/$defs/nullableTimestamp"
    },
    "duration_ms": {
      "$ref": "#/$defs/nullableNonNegativeInteger"
    },
    "timing_status": {
      "$ref": "#/$defs/timingStatus"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "parallel_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parallelGroup"
      }
    },
    "runtime_summary": {
      "$ref": "#/$defs/runtimeSummary"
    },
    "human_approval": {
      "$ref": "#/$defs/humanApproval"
    },
    "release_gates": {
      "$ref": "#/$defs/releaseGates"
    },
    "boundaries": {
      "$ref": "#/$defs/boundaries"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "timing_status": {
            "const": "measured"
          }
        },
        "required": ["timing_status"]
      },
      "then": {
        "properties": {
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "ended_at": {
            "type": "string",
            "minLength": 1
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "else": {
        "properties": {
          "started_at": {
            "type": "null"
          },
          "ended_at": {
            "type": "null"
          },
          "duration_ms": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableTimestamp": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "nullableNonNegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "timingStatus": {
      "enum": [
        "measured",
        "historical_not_available",
        "not_applicable"
      ]
    },
    "runStatus": {
      "enum": [
        "running",
        "pass",
        "needs_review",
        "needs_revision",
        "blocked",
        "failed"
      ]
    },
    "nodeStatus": {
      "enum": [
        "queued",
        "running",
        "pass",
        "needs_review",
        "needs_revision",
        "blocked",
        "skipped",
        "failed"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_path"],
      "properties": {
        "file_path": {
          "description": "Path to a real project artifact. The schema enforces a non-empty path; the Runtime Runner must verify the file exists and is not fabricated.",
          "type": "string",
          "minLength": 1
        },
        "json_pointer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "modelUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usage_status",
        "provider",
        "model",
        "prompt_tokens",
        "completion_tokens",
        "total_tokens",
        "estimated_cost",
        "currency"
      ],
      "properties": {
        "usage_status": {
          "enum": [
            "measured",
            "not_used",
            "not_available"
          ]
        },
        "provider": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "model": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "prompt_tokens": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "completion_tokens": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "total_tokens": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "estimated_cost": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "currency": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "usage_status": {
                "const": "measured"
              }
            },
            "required": ["usage_status"]
          },
          "then": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "prompt_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "completion_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "estimated_cost": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "provider": {
                "type": "null"
              },
              "model": {
                "type": "null"
              },
              "prompt_tokens": {
                "type": "null"
              },
              "completion_tokens": {
                "type": "null"
              },
              "total_tokens": {
                "type": "null"
              },
              "estimated_cost": {
                "type": "null"
              },
              "currency": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "call_status"],
      "properties": {
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "call_status": {
          "enum": ["measured", "not_available"]
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "duration_ms": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "input_summary": {
          "type": ["string", "null"]
        },
        "output_summary": {
          "type": ["string", "null"]
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "error_message"],
      "properties": {
        "error_code": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "error_message": {
          "type": ["string", "null"],
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_name",
        "node_type",
        "sequence",
        "execution_group",
        "status",
        "started_at",
        "ended_at",
        "duration_ms",
        "timing_status",
        "input_refs",
        "output_refs",
        "retry_count",
        "retry_count_status",
        "model_usage",
        "tool_calls",
        "error",
        "risk_ids",
        "claim_ids"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "node_name": {
          "type": "string",
          "minLength": 1
        },
        "node_type": {
          "enum": [
            "agent",
            "skill",
            "governance",
            "human",
            "evaluation",
            "report"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "execution_group": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/nodeStatus"
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "duration_ms": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "timing_status": {
          "$ref": "#/$defs/timingStatus"
        },
        "input_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "output_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "retry_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "retry_count_status": {
          "enum": [
            "measured",
            "not_available",
            "not_applicable"
          ]
        },
        "model_usage": {
          "$ref": "#/$defs/modelUsage"
        },
        "tool_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolCall"
          }
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "risk_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "timing_status": {
                "const": "measured"
              }
            },
            "required": ["timing_status"]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string",
                "minLength": 1
              },
              "ended_at": {
                "type": "string",
                "minLength": 1
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "started_at": {
                "type": "null"
              },
              "ended_at": {
                "type": "null"
              },
              "duration_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "retry_count_status": {
                "const": "measured"
              }
            },
            "required": ["retry_count_status"]
          },
          "then": {
            "properties": {
              "retry_count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "retry_count": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "parallelGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_id",
        "fan_out_from",
        "parallel_node_ids",
        "fan_in_to",
        "started_at",
        "ended_at",
        "duration_ms",
        "timing_status",
        "status"
      ],
      "properties": {
        "group_id": {
          "type": "string",
          "minLength": 1
        },
        "fan_out_from": {
          "description": "Planner node id that fans out into the parallel Skill nodes.",
          "type": "string",
          "minLength": 1
        },
        "parallel_node_ids": {
          "description": "Distinct node ids for Audience Insight, Selling Point Analyst, and Platform Strategy. These must remain separate Runtime nodes and fan in before Creative Agent.",
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fan_in_to": {
          "description": "Node id that receives the fan-in result before the Creative Agent route.",
          "type": "string",
          "minLength": 1
        },
        "started_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/nullableTimestamp"
        },
        "duration_ms": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "timing_status": {
          "$ref": "#/$defs/timingStatus"
        },
        "status": {
          "$ref": "#/$defs/nodeStatus"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "timing_status": {
                "const": "measured"
              }
            },
            "required": ["timing_status"]
          },
          "then": {
            "properties": {
              "started_at": {
                "type": "string",
                "minLength": 1
              },
              "ended_at": {
                "type": "string",
                "minLength": 1
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "properties": {
              "started_at": {
                "type": "null"
              },
              "ended_at": {
                "type": "null"
              },
              "duration_ms": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "runtimeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_count",
        "completed_node_count",
        "failed_node_count",
        "blocked_node_count",
        "retry_count",
        "model_call_count",
        "tool_call_count",
        "total_input_tokens",
        "total_output_tokens",
        "estimated_cost",
        "currency",
        "summary_status"
      ],
      "properties": {
        "node_count": {
          "type": "integer",
          "minimum": 0
        },
        "completed_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_node_count": {
          "type": "integer",
          "minimum": 0
        },
        "retry_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "model_call_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "tool_call_count": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "total_input_tokens": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "total_output_tokens": {
          "$ref": "#/$defs/nullableNonNegativeInteger"
        },
        "estimated_cost": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "currency": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "summary_status": {
          "enum": ["measured", "not_available", "not_applicable"]
        }
      }
    },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_decision",
        "human_signature",
        "reviewer_name",
        "reviewed_at"
      ],
      "properties": {
        "overall_decision": {
          "enum": [
            "needs_review",
            "needs_revision",
            "pass",
            "blocked",
            "failed"
          ]
        },
        "human_signature": {
          "enum": [
            "pending",
            "completed",
            "not_required"
          ]
        },
        "reviewer_name": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "reviewed_at": {
          "$ref": "#/$defs/nullableTimestamp"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "human_signature": {
                "const": "completed"
              }
            },
            "required": ["human_signature"]
          },
          "then": {
            "properties": {
              "reviewer_name": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "else": {
            "properties": {
              "reviewer_name": {
                "type": "null"
              },
              "reviewed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "releaseGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_marketing_copy",
        "final_image_prompt",
        "image_generation",
        "frontend_page",
        "public_release"
      ],
      "properties": {
        "final_marketing_copy": {
          "const": "blocked"
        },
        "final_image_prompt": {
          "const": "blocked"
        },
        "image_generation": {
          "const": "blocked"
        },
        "frontend_page": {
          "const": "blocked"
        },
        "public_release": {
          "const": "blocked"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_ready",
        "customer_validated",
        "real_customer_data_used",
        "realtime_model_execution"
      ],
      "properties": {
        "production_ready": {
          "const": false,
          "default": false
        },
        "customer_validated": {
          "const": false,
          "default": false
        },
        "real_customer_data_used": {
          "const": false,
          "default": false
        },
        "realtime_model_execution": {
          "type": "boolean",
          "description": "Must be set according to the actual run. Do not default to true."
        }
      }
    }
  }
}
